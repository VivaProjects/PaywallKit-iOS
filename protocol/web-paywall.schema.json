{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:paywall:web:1",
  "title": "Web paywall delivery document",
  "type": "object",
  "required": ["kind", "bridgeVersion", "documentId", "revision", "pageUrl", "catalogKey", "productRefs", "initialProductRef"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "web-paywall"},
    "bridgeVersion": {"const": 2},
    "documentId": {"type": "string", "minLength": 1, "maxLength": 80},
    "revision": {"type": "integer", "minimum": 1},
    "pageUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
    "catalogKey": {"type": "string", "minLength": 1, "maxLength": 80},
    "productRefs": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}},
    "initialProductRef": {"type": "string"}
  }
}
